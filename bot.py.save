        )
        await bot.send_message(_get_payment_log_channel(), msg)
    except Exception as exc:
        logger.error(f"log_primary_deposit error: {exc}")


async def log_primary_purchase(uid: int, country: str, price: int, amount: int, year: int, qty: int, phone: str = None, otp: str = None, twofa: str = None):
    try:
        t = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        me = await get_bot_me()
        bot_username = f"@{me.username}" if me and me.username else ""

        # Hide middle digits of phone: +91XXXXX1234 → show first 5 and last 3
        def mask_phone(p):
            if not p:
                return "N/A"
            p = str(p).strip()
            if len(p) <= 8:
                return p
            return p[:5] + "•" * (len(p) - 8) + p[-3:]

        # Hide OTP: show first 1 and last 1 digit, mask middle
        def mask_otp(o):
            if not o:
                return "N/A"
            o = str(o).strip()
            if len(o) <= 2:
                return "*" * len(o)
            return o[0] + "*" * (len(o) - 2) + o[-1]

        phone_display = mask_phone(phone)
        otp_display = mask_otp(otp)
        twofa_display = twofa if twofa and twofa != "None" else "Disabled"

        msg = (
            f"<b>🛍️ New Number Purchased</b>\n\n"
            f"<blockquote>"
            f"🌍 <b>Country :</b> {country}\n"
            f"📅 <b>Year :</b> {year}\n"
            f"📦 <b>Qty :</b> {qty}"
            f"</blockquote>\n\n"
            f"<blockquote>"
            f"📱 <b>Number :</b> <code>{phone_display}</code>\n"
            f"🔑 <b>OTP :</b> <code>{otp_display}</code>\n"
            f"🔒 <b>2FA :</b> <code>{twofa_display}</code>"
            f"</blockquote>\n\n"
            f"<blockquote>"
            f"💰 <b>Price :</b> {P_INR}{price}\n"
            f"🕐 <b>Time :</b> {t}"
            f"</blockquote>\n\n"
            f"🆔 <b>User ID :</b> <code>{uid}</code>\n\n"
            f"✦ {bot_username} ✦"
        )
        await bot.send_message(_get_purchase_log_channel(), msg)
    except Exception as exc:
        logger.error(f"log_primary_purchase error: {exc}")



            f"{P_ACC} User ID: <code>{uid}</code>\n"
            f"👤 Username: @{username}\n"
            f"{P_MONEY} Amount: {P_INR}{amt}\n"
            f"{P_CARD} Method: {method}\n"
            f"{P_TIME} Time: {t}\n\n"
